{
  "name": "research-agent",
  "description": "Research agent with web access, file operations, and memory",
  "tools": [
    "fs_read",
    "fs_write",
    "grep",
    "web_search",
    "fetch",
    "@memory"
  ],
  "allowedTools": [
    "*",
    "@memory/learn",
    "@memory/search"
  ],
  "resources": [
    "file://.kiro/SubAgents.md",
    "file://.kiro/agents/*.json",
    "file://README.md",
    "file://.kiro/projects/memory-rs/*.md",
    "skill://skill/agent-memory/SKILL.md"
  ],
  "mcpServers": {
    "memory": {
      "command": "/Users/kenneth/workspace/memory-rs/target/release/agent-memory-mcp",
      "args": ["memory-rs-workspace"],
      "env": {
        "MEMORY_MODEL": "bge"
      }
    }
  }
}
